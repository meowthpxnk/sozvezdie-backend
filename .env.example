# Refresh cookie path: empty locally (/refresh-session), "/api" behind nginx (/api/refresh-session)
API_ROOT_PATH=
# Local API listen port (docker maps 8000:8000; override locally if 8000 is taken)
API_PORT=8080
# Set false only for local HTTP without TLS (default true; localhost is treated as secure)
REFRESH_COOKIE_SECURE=true

# Database
DATABASE_URI=postgresql+asyncpg://app_user:app_password@localhost:4002/app_db

# Redis
REDIS_URI=redis://localhost:4001

# MinIO
MINIO_URI=http://localhost:4003

# Super moderator (created/updated on app startup; role is not stored in DB enum)
SUPER_MODERATOR_USERNAME=superadmin
SUPER_MODERATOR_PASSWORD=SuperAdmin123

# Hide sellers without a unique 1C author ID from the public catalog and lock their cabinet
BLOCKED_1C_USERS=false

# VK ID (OAuth + API)
VK_API_VERSION=5.199
VK_OAUTH_DOMAIN=id.vk.ru
VK_CLIENT_ID=54607259
VK_REDIRECT_URI=https://constellationshop.ru

# CDEK (test: https://api.edu.cdek.ru, prod: https://api.cdek.ru)
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_BASE=https://api.edu.cdek.ru
CDEK_FROM_CITY_CODE=137
CDEK_FROM_ADDRESS=г. Санкт-Петербург, ул. Печатника Григорьева, д. 8
CDEK_DEFAULT_WEIGHT_G=1000
CDEK_DEFAULT_LENGTH_CM=20
CDEK_DEFAULT_WIDTH_CM=20
CDEK_DEFAULT_HEIGHT_CM=10
# PVZ lookup: page size and max pages when loading all points in a city
CDEK_PVZ_PAGE_SIZE=1000
CDEK_PVZ_MAX_PAGES=20
# Days until the seller hands the parcel to CDEK (used in tariff calculator `date`)
CDEK_SHIPMENT_DAYS_OFFSET=0

# DaData
DADATA_API_KEY=7c131e1b374ac8b09b8e74890600bbb1e5bc3930
DADATA_SECRET_KEY=ce1829599e5256eb6ab2c981d3d88555d98f65f0

# YooKassa (test shop: shopId + secret key from ЛК → Интеграция → Ключи API)
YOOKASSA_SHOP_ID=1372183
YOOKASSA_SECRET_KEY=test_2EFmVm2XS3KIZ63MaJe3_vsJkowVN5hRJ0fKHOiZ9bM
# URL, куда ЮKassa вернёт пользователя после оплаты (страница фронта)
# После оплаты ЮKassa добавит ?checkout_id=… (см. build_return_url)
YOOKASSA_RETURN_URL=http://localhost:3000/orders/payment/return
# Webhook (обязателен, если пользователь не вернулся со страницы ЮKassa):
# ЛК ЮKassa → Интеграция → HTTP-уведомления → https://<api>/payment/webhook
# События: payment.succeeded, payment.canceled
# Локально: ngrok http 8000 → указать https://xxx.ngrok.io/payment/webhook

# RuSender (транзакционные письма: верификация почты, восстановление пароля)
RUSENDER_API_TOKEN=rs_ck_v1_2p325iyhsxwpt46i_733a6971b535f42abc961d6dc008cbeac13710bd39160e427559c3e13a5c94cf
RUSENDER_KEY_ID=9206
RUSENDER_FROM_EMAIL=support@constellationshop.ru
RUSENDER_FROM_NAME=Команда Созвездие
RUSENDER_API_BASE=https://api.rusender.ru
FRONTEND_URL=http://localhost:3000
