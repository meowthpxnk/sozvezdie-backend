# YooKassa (test shop: shopId + secret key from ЛК → Интеграция → Ключи API)
YOOKASSA_SHOP_ID=1372183
YOOKASSA_SECRET_KEY=test_2EFmVm2XS3KIZ63MaJe3_vsJkowVN5hRJ0fKHOiZ9bM
# URL, куда ЮKassa вернёт пользователя после оплаты (страница фронта)
# После оплаты ЮKassa добавит ?checkout_id=… (см. build_return_url)
YOOKASSA_RETURN_URL=http://localhost:3000/orders/payment/return
# Webhook (обязателен, если пользователь не вернулся со страницы ЮKassa):
# ЛК ЮKassa → Интеграция → HTTP-уведомления → https://<api>/payment/webhook
# События: payment.succeeded, payment.canceled
# Локально: ngrok http 8000 → указать https://xxx.ngrok.io/payment/webhook
